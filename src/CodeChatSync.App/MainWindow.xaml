<Window
	x:Class="CodeChatSync.App.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="CodeChatSync">
	<Window.SystemBackdrop>
		<MicaBackdrop />
	</Window.SystemBackdrop>

	<Grid x:Name="WindowRoot" MinWidth="720" MinHeight="560">
		<Grid.Resources>
			<Style x:Key="CardStyle" TargetType="Border">
				<Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="4" />
				<Setter Property="Padding" Value="16,12" />
				<Setter Property="MinHeight" Value="68" />
			</Style>
			<Style x:Key="PageTitleStyle" TargetType="TextBlock">
				<Setter Property="FontSize" Value="28" />
				<Setter Property="LineHeight" Value="36" />
				<Setter Property="FontWeight" Value="SemiBold" />
			</Style>
			<Style x:Key="SectionTitleStyle" TargetType="TextBlock">
				<Setter Property="FontSize" Value="14" />
				<Setter Property="FontWeight" Value="SemiBold" />
				<Setter Property="Margin" Value="0,24,0,4" />
			</Style>
			<Style x:Key="CaptionStyle" TargetType="TextBlock">
				<Setter Property="FontSize" Value="12" />
				<Setter Property="LineHeight" Value="16" />
				<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
				<Setter Property="TextWrapping" Value="Wrap" />
			</Style>
			<Style x:Key="MonoCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
				<Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
				<Setter Property="TextWrapping" Value="NoWrap" />
				<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			</Style>
			<Style x:Key="VerticalDividerStyle" TargetType="Border">
				<Setter Property="Width" Value="1" />
				<Setter Property="Height" Value="24" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
			</Style>
			<Style x:Key="ChatRowStyle" TargetType="Border">
				<Setter Property="Padding" Value="12,4" />
				<Setter Property="BorderThickness" Value="0,0,0,1" />
				<Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
			</Style>
			<Style x:Key="ChatListStyle" TargetType="Border">
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="4" />
				<Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
				<Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
			</Style>
			<Style x:Key="CardIconStyle" TargetType="FontIcon">
				<Setter Property="FontSize" Value="20" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Margin" Value="0,0,16,0" />
			</Style>
			<Style x:Key="StepDoneIconStyle" TargetType="FontIcon">
				<Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
			</Style>
			<Style x:Key="StepPendingIconStyle" TargetType="FontIcon">
				<Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
			</Style>
		</Grid.Resources>
		<Grid.RowDefinitions>
			<RowDefinition Height="48" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Border Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center"
					Background="{ThemeResource AccentFillColorDefaultBrush}">
				<FontIcon Glyph="&#xE895;" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
			</Border>
			<TextBlock Grid.Column="1" Text="CodeChatSync" FontSize="12" VerticalAlignment="Center" />
		</Grid>

		<NavigationView x:Name="NavView" Grid.Row="1"
						PaneDisplayMode="Left" OpenPaneLength="240"
						IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False"
						IsSettingsVisible="False" SelectionChanged="OnNavigationSelectionChanged">
									<!-- A custom item: the built-in Settings item follows the OS language, while the UI is English. -->
									<NavigationView.FooterMenuItems>
										<NavigationViewItem x:Name="SettingsNavItem" Content="Settings" Tag="settings">
											<NavigationViewItem.Icon>
												<FontIcon Glyph="&#xE713;" />
											</NavigationViewItem.Icon>
										</NavigationViewItem>
									</NavigationView.FooterMenuItems>
			<NavigationView.MenuItems>
				<NavigationViewItem x:Name="SyncNavItem" Content="Sync" Tag="sync">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE895;" />
					</NavigationViewItem.Icon>
				</NavigationViewItem>
				<NavigationViewItem x:Name="ProjectsNavItem" Tag="projects" HorizontalContentAlignment="Stretch"
													AutomationProperties.Name="Projects">
					<NavigationViewItem.Icon>
						<FontIcon Glyph="&#xE8B7;" />
					</NavigationViewItem.Icon>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="Projects" />
						<TextBlock x:Name="ProjectsCountText" Grid.Column="1" Margin="12,0,12,0"
								   Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
					</Grid>
				</NavigationViewItem>
			</NavigationView.MenuItems>

			<Grid>
				<!-- Sync page -->
				<ScrollViewer x:Name="SyncPage" VerticalScrollBarVisibility="Auto">
					<Grid Padding="40,28,40,48">
						<StackPanel Spacing="4">
							<TextBlock Text="Sync" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20" />

							<Border x:Name="GettingStartedCard" Visibility="Collapsed" Margin="0,0,0,16"
									Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									BorderThickness="1" CornerRadius="8" Padding="20">
								<StackPanel Spacing="12">
									<Grid ColumnSpacing="12">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<StackPanel>
											<TextBlock Text="Get started" FontSize="20" LineHeight="28" FontWeight="SemiBold" />
											<TextBlock x:Name="GettingStartedSummaryText" Style="{StaticResource CaptionStyle}" FontSize="14" LineHeight="20" />
										</StackPanel>
										<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
											<Button Content="Open setup guide" Click="OnOpenSetupGuideClick" />
											<Button Content="Hide" Style="{StaticResource SubtleButtonStyle}" Click="OnHideGettingStartedClick"
													ToolTipService.ToolTip="Hide this checklist. Reopen it from Settings &gt; Help." />
										</StackPanel>
									</Grid>
									<ProgressBar x:Name="GettingStartedProgressBar" Maximum="4" />

									<Grid ColumnSpacing="16">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<FontIcon x:Name="FolderStepIcon" Glyph="&#xEA3A;" FontSize="18" VerticalAlignment="Center" />
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
											<TextBlock Text="1. Choose a private sync folder" />
											<TextBlock Text="A dedicated local Git repository that stores archived chats. Never a client project folder."
													   Style="{StaticResource CaptionStyle}" />
										</StackPanel>
										<Button x:Name="FolderStepButton" Grid.Column="2" Content="Choose folder"
												VerticalAlignment="Center" Click="OnFolderStepClick" />
									</Grid>
									<Grid ColumnSpacing="16">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<FontIcon x:Name="RemoteStepIcon" Glyph="&#xEA3A;" FontSize="18" VerticalAlignment="Center" />
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
											<TextBlock Text="2. Connect a private Git remote (optional)" />
											<TextBlock Text="Push chats to your private GitHub or Azure DevOps repository so your other PCs receive them."
													   Style="{StaticResource CaptionStyle}" />
										</StackPanel>
										<Button x:Name="RemoteStepButton" Grid.Column="2" Content="Set remote"
												VerticalAlignment="Center" Click="OnRemoteStepClick" />
									</Grid>
									<Grid ColumnSpacing="16">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<FontIcon x:Name="ProjectStepIcon" Glyph="&#xEA3A;" FontSize="18" VerticalAlignment="Center" />
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
											<TextBlock Text="3. Add a project" />
											<TextBlock Text="Pick a Visual Studio (Copilot) or Claude Code project. Projects are matched across PCs by their Git remote."
													   Style="{StaticResource CaptionStyle}" />
										</StackPanel>
										<Button x:Name="ProjectStepButton" Grid.Column="2" Content="Add project"
												VerticalAlignment="Center" Click="OnProjectStepClick" />
									</Grid>
									<Grid ColumnSpacing="16">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<FontIcon x:Name="SyncStepIcon" Glyph="&#xEA3A;" FontSize="18" VerticalAlignment="Center" />
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
											<TextBlock Text="4. Run your first sync" />
											<TextBlock Text="Close Visual Studio and Claude Code, then choose Sync now. Later syncs run by themselves."
													   Style="{StaticResource CaptionStyle}" />
										</StackPanel>
										<Button x:Name="SyncStepButton" Grid.Column="2" Content="Show me"
												VerticalAlignment="Center" Click="OnSyncStepClick" />
									</Grid>
								</StackPanel>
							</Border>

							<Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									BorderThickness="1" CornerRadius="8">
								<StackPanel>
									<Grid Padding="20" ColumnSpacing="16">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<Grid Width="40" Height="40" VerticalAlignment="Center">
											<Border x:Name="StatusNeutralIcon" CornerRadius="20" BorderThickness="1"
													BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
													Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
												<FontIcon x:Name="StatusNeutralGlyph" Glyph="&#xE895;" FontSize="18"
														  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
											</Border>
											<Border x:Name="StatusSyncingIcon" CornerRadius="20" Visibility="Collapsed"
													Background="{ThemeResource AccentFillColorDefaultBrush}">
												<FontIcon Glyph="&#xE895;" FontSize="18"
														  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
											</Border>
											<Border x:Name="StatusSuccessIcon" CornerRadius="20" Visibility="Collapsed"
													Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
												<FontIcon Glyph="&#xE73E;" FontSize="18"
														  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
											</Border>
											<Border x:Name="StatusCautionIcon" CornerRadius="20" Visibility="Collapsed"
													Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
												<FontIcon x:Name="StatusCautionGlyph" Glyph="&#xE823;" FontSize="18"
														  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
											</Border>
											<Border x:Name="StatusErrorIcon" CornerRadius="20" Visibility="Collapsed"
													Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
												<FontIcon Glyph="&#xE7BA;" FontSize="18"
														  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
											</Border>
										</Grid>
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
											<TextBlock x:Name="StatusTitleText" Text="Ready" FontSize="20" LineHeight="28" FontWeight="SemiBold" />
											<TextBlock x:Name="StatusDescriptionText" TextWrapping="Wrap"
													   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
										</StackPanel>
										<Button x:Name="SyncNowButton" Grid.Column="2" Content="Sync now"
												Style="{StaticResource AccentButtonStyle}" Padding="20,5"
												VerticalAlignment="Center" Click="OnSyncNowClick" />
									</Grid>
									<ProgressBar x:Name="SyncProgressBar" IsIndeterminate="True" Visibility="Collapsed"
												 Margin="76,0,20,20" />
									<Grid Padding="20,12" ColumnSpacing="24"
										  Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
										  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<StackPanel>
											<TextBlock Text="Repository" Style="{StaticResource CaptionStyle}" />
											<TextBlock x:Name="RepositorySummaryText" Text="No remote set"
													   FontFamily="Cascadia Mono, Consolas" FontSize="13"
													   TextTrimming="CharacterEllipsis" />
										</StackPanel>
										<StackPanel Grid.Column="1">
											<TextBlock Text="Local folder" Style="{StaticResource CaptionStyle}" />
											<TextBlock x:Name="FolderSummaryText" Text="Not configured"
													   FontFamily="Cascadia Mono, Consolas" FontSize="13"
													   TextTrimming="CharacterEllipsis" />
										</StackPanel>
									</Grid>
								</StackPanel>
							</Border>

							<TextBlock Text="Automatic sync" Style="{StaticResource SectionTitleStyle}" />
							<Border Style="{StaticResource CardStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<FontIcon Glyph="&#xE895;" Style="{StaticResource CardIconStyle}" />
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="Sync automatically after the chat tool closes" TextWrapping="Wrap" />
										<TextBlock Text="Applies to Visual Studio and Claude Code. Sync now and per-project sync keep working when this is off."
												   Style="{StaticResource CaptionStyle}" />
									</StackPanel>
									<ToggleSwitch x:Name="AutomaticSyncToggle" Grid.Column="2" MinWidth="0"
												  VerticalAlignment="Center" Margin="16,0,0,0"
												  Toggled="OnAutomaticSyncToggled" />
								</Grid>
							</Border>
							<InfoBar x:Name="AutomaticSyncInfoBar" IsOpen="False" IsClosable="True" />

							<TextBlock Text="Last sync" Style="{StaticResource SectionTitleStyle}" />
							<Border Style="{StaticResource CardStyle}" MinHeight="0" Padding="16">
								<TextBlock x:Name="LastRunText" TextWrapping="Wrap"
										   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										   Text="No sync has run yet in this session." />
							</Border>
						</StackPanel>
					</Grid>
				</ScrollViewer>

				<!-- Projects page -->
				<ScrollViewer x:Name="ProjectsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
					<Grid Padding="40,28,40,48">
						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<TextBlock Text="Projects on this PC" Style="{StaticResource PageTitleStyle}" />
								<Button x:Name="RefreshProjectsButton" Style="{StaticResource SubtleButtonStyle}"
										VerticalAlignment="Center" Click="OnRefreshProjectsClick">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<FontIcon Glyph="&#xE72C;" FontSize="14" />
										<TextBlock Text="Refresh" />
									</StackPanel>
								</Button>
							</StackPanel>
							<TextBlock Text="Projects are identified by their Git remote. Supported: Visual Studio (Copilot) and Claude Code; one project can use both."
									   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,16" />
							<InfoBar x:Name="ProjectInfoBar" IsOpen="False" IsClosable="True" />
							<StackPanel x:Name="ProjectsPanel" Spacing="4" />

							<Expander x:Name="AddProjectExpander" IsExpanded="False"
									  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
								<Expander.Header>
									<Grid MinHeight="44">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="32" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<FontIcon Glyph="&#xE710;" FontSize="16" />
										<TextBlock Grid.Column="1" Text="Add a project" Margin="16,0,0,0" VerticalAlignment="Center" />
									</Grid>
								</Expander.Header>
								<StackPanel Spacing="12" Padding="48,4,0,4">
									<RadioButtons x:Name="AddProviderRadioButtons" Header="Provider" MaxColumns="2"
												  SelectedIndex="0" SelectionChanged="OnAddProviderChanged">
										<x:String>Visual Studio (Copilot)</x:String>
										<x:String>Claude Code</x:String>
									</RadioButtons>

									<StackPanel x:Name="VisualStudioAddPanel" Spacing="8">
										<TextBlock Text="Choose a folder in the project's Git repository. The remote identifies it across PCs."
												   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
										<TextBlock Text="Project folder" Margin="0,4,0,0" />
										<Grid ColumnSpacing="8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<TextBox x:Name="ProjectFolderTextBox" PlaceholderText="Folder inside the project's Git repository" />
											<Button Grid.Column="1" Content="Browse for project…" Click="OnBrowseProjectClick" />
										</Grid>
										<Expander Header="Advanced options" IsExpanded="False"
												  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
											<StackPanel Spacing="10">
												<TextBox x:Name="ProjectNameTextBox" Header="Sync folder name (optional)"
														 PlaceholderText="Defaults to a name derived from the remote" />
												<TextBox x:Name="ProjectRemoteTextBox" Header="Remote override (optional)"
														 PlaceholderText="Use when the folder has no origin remote" />
											</StackPanel>
										</Expander>
										<Button x:Name="AddProjectButton" Content="Add project" Margin="0,8,0,0"
												Style="{StaticResource AccentButtonStyle}" Click="OnAddProjectClick" />
									</StackPanel>

									<StackPanel x:Name="ClaudeAddPanel" Spacing="8" Visibility="Collapsed">
										<TextBlock Text="Pick a project from your Claude Code projects folder. Only Git repository roots with a remote can be added; the same remote can also have Copilot chats. Close Claude Code completely (including node-hosted instances) first."
												   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
										<Button x:Name="DiscoverClaudeButton" Content="Find Claude Code projects"
												Click="OnDiscoverClaudeClick" />
										<StackPanel x:Name="ClaudeCandidatePanel" Spacing="4" />
									</StackPanel>
								</StackPanel>
							</Expander>

							<TextBlock x:Name="RestoreSectionTitle" Text="Chats to restore on this PC" FontSize="20" LineHeight="28" FontWeight="SemiBold" Margin="0,32,0,4" />
							<TextBlock Text="Uncheck Restore on this PC beside a project, then save, to exclude all its archived chats from restores here. Expand it to select individual chats instead. The Git clone, uploads, and existing local chats are unaffected."
									   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
							<TextBlock Text="Claude Code restores currently require the same project path on both PCs. Chats with another or missing cwd are skipped."
									   Style="{StaticResource CaptionStyle}" Margin="0,4,0,16" />
							<StackPanel x:Name="SessionSelectionPanel" Spacing="4" />
							<StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
								<Button x:Name="SaveSelectionButton" Content="Save chat selection"
										Style="{StaticResource AccentButtonStyle}" Click="OnSaveSelectionClick" />
								<TextBlock x:Name="SelectionHintText" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
							</StackPanel>
							<InfoBar x:Name="SelectionInfoBar" IsOpen="False" IsClosable="True" />
						</StackPanel>
					</Grid>
				</ScrollViewer>

				<!-- Settings page -->
				<ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
					<Grid Padding="40,28,40,48">
						<StackPanel Spacing="4">
							<TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" Margin="0,0,0,20" />

							<TextBlock Text="Sync repository" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
							<Border Padding="16,12" CornerRadius="4" BorderThickness="1"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
								<StackPanel Orientation="Horizontal" Spacing="12">
									<FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
									<TextBlock Text="Use a dedicated private Git repository. Never point this at a client project folder."
											   TextWrapping="Wrap" />
								</StackPanel>
							</Border>
							<Border Style="{StaticResource CardStyle}">
								<Grid ColumnSpacing="8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="340" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<FontIcon Glyph="&#xE8B7;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="Local sync folder" />
										<TextBlock Text="A local clone of your private sync repository." Style="{StaticResource CaptionStyle}" />
									</StackPanel>
									<TextBox x:Name="SyncFolderTextBox" Grid.Column="2" VerticalAlignment="Center"
											 TextChanged="OnSyncFolderChanged" FontFamily="Cascadia Mono, Consolas"
											 PlaceholderText="Choose an existing clone or a new folder" />
									<Button Grid.Column="3" Content="Browse…" VerticalAlignment="Center" Click="OnBrowseFolderClick" />
								</Grid>
							</Border>
							<Border Style="{StaticResource CardStyle}">
								<Grid ColumnSpacing="8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<FontIcon Glyph="&#xE71B;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="Git origin URL" />
										<TextBlock Text="Optional. Chats are pushed here after each sync. Leave blank to keep the existing remote."
												   Style="{StaticResource CaptionStyle}" />
									</StackPanel>
									<TextBox x:Name="RemoteTextBox" Grid.Column="2" Width="340" VerticalAlignment="Center"
											 PlaceholderText="https://github.com/owner/repo" />
								</Grid>
							</Border>
							<Border Style="{StaticResource CardStyle}">
								<Grid ColumnSpacing="8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<FontIcon Glyph="&#xE8F4;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="Initialize as a Git repository if needed" />
										<TextBlock Text="Runs git init in the sync folder when it isn't a repository yet."
												   Style="{StaticResource CaptionStyle}" />
									</StackPanel>
									<ToggleSwitch x:Name="InitializeToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
								</Grid>
							</Border>
							<StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
								<Button x:Name="SaveSettingsButton" Content="Save repository settings"
										Style="{StaticResource AccentButtonStyle}" Click="OnSaveSettingsClick" />
								<ProgressRing x:Name="SettingsProgress" IsActive="False" Width="20" Height="20" />
							</StackPanel>
							<InfoBar x:Name="SettingsInfoBar" IsOpen="False" IsClosable="True" />

							<TextBlock Text="Appearance" Style="{StaticResource SectionTitleStyle}" />
							<Border Style="{StaticResource CardStyle}">
								<Grid ColumnSpacing="8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<FontIcon Glyph="&#xE790;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="App theme" />
										<TextBlock Text="Saved on this PC." Style="{StaticResource CaptionStyle}" />
									</StackPanel>
									<ComboBox x:Name="ThemeComboBox" Grid.Column="2" Width="200" VerticalAlignment="Center"
											  SelectionChanged="OnThemeSelectionChanged">
										<ComboBoxItem Content="Use system setting" />
										<ComboBoxItem Content="Light" />
										<ComboBoxItem Content="Dark" />
									</ComboBox>
								</Grid>
							</Border>
							<InfoBar x:Name="ThemeInfoBar" IsOpen="False" IsClosable="True" />

							<TextBlock Text="Advanced" Style="{StaticResource SectionTitleStyle}" />
							<Border Style="{StaticResource CardStyle}">
								<Grid ColumnSpacing="8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<FontIcon Glyph="&#xE7BA;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0"
											  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="Sync Visual Studio while it is running" />
										<TextBlock Style="{StaticResource CaptionStyle}"
												   Text="Not recommended. Skips the check that waits for Visual Studio to close: Copilot chats under .vs are read and restored even while Visual Studio may be using them, which can archive incomplete chats or be overwritten by Visual Studio. Local files are still backed up before being replaced. Automatic sync still waits for Visual Studio to close. Saved on this PC." />
									</StackPanel>
									<ToggleSwitch x:Name="SkipVisualStudioCheckToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
												  Tag="visualstudio" Toggled="OnSkipRunningCheckToggled" />
								</Grid>
							</Border>
							<InfoBar x:Name="SkipVisualStudioCheckInfoBar" IsOpen="False" IsClosable="False" Severity="Warning"
									 Title="Visual Studio running check is off"
									 Message="Chats sync even while Visual Studio is open. Close Visual Studio before syncing whenever you can." />
							<Border Style="{StaticResource CardStyle}">
								<Grid ColumnSpacing="8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<FontIcon Glyph="&#xE7BA;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0"
											  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="Sync Claude Code while it is running" />
										<TextBlock Style="{StaticResource CaptionStyle}"
												   Text="Not recommended. Skips the check that waits for Claude Code to close: transcripts are read and restored even while a session may be writing them, which can archive incomplete chats or overwrite changes. Local files are still backed up before being replaced. Automatic sync still waits for Claude Code to close. Saved on this PC." />
									</StackPanel>
									<ToggleSwitch x:Name="SkipClaudeCheckToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center"
												  Tag="claudecode" Toggled="OnSkipRunningCheckToggled" />
								</Grid>
							</Border>
							<InfoBar x:Name="SkipClaudeCheckInfoBar" IsOpen="False" IsClosable="False" Severity="Warning"
									 Title="Claude Code running check is off"
									 Message="Chats sync even while Claude Code is open. Close Claude Code before syncing whenever you can." />

							<TextBlock Text="Help" Style="{StaticResource SectionTitleStyle}" />
							<Border Style="{StaticResource CardStyle}">
								<Grid ColumnSpacing="8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<FontIcon Glyph="&#xE897;" Style="{StaticResource CardIconStyle}" Margin="0,0,8,0" />
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="Setup guide and tour" />
										<TextBlock Text="Walk through setup again, show the Get started checklist on the Sync page, or take a quick tour of the window."
												   Style="{StaticResource CaptionStyle}" />
									</StackPanel>
									<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
										<Button x:Name="OpenSetupGuideButton" Content="Open setup guide" Click="OnOpenSetupGuideClick" />
										<Button Content="Take the tour" Click="OnStartTourClick" />
									</StackPanel>
								</Grid>
							</Border>
						</StackPanel>
					</Grid>
				</ScrollViewer>
			</Grid>
		</NavigationView>

		<!-- Contextual hints: one tip retargeted for the tour and for checklist actions. -->
		<TeachingTip x:Name="GuideTip" Grid.Row="1" PreferredPlacement="Auto" IsLightDismissEnabled="False"
					 ActionButtonClick="OnGuideTipActionClick" CloseButtonClick="OnGuideTipCloseClick" Closed="OnGuideTipClosed" />

		<!-- First-run setup wizard. -->
		<ContentDialog x:Name="SetupDialog" Grid.Row="1" DefaultButton="Primary"
					   PrimaryButtonClick="OnSetupPrimaryClick" SecondaryButtonClick="OnSetupSecondaryClick">
			<StackPanel Width="480" Spacing="12">
				<TextBlock x:Name="SetupStepText" Style="{StaticResource CaptionStyle}" />

				<StackPanel x:Name="SetupWelcomePage" Spacing="12">
					<TextBlock TextWrapping="Wrap"
							   Text="CodeChatSync keeps your AI chats (Copilot in Visual Studio and Claude Code) in sync across your PCs through a private Git repository that you own. Chats never go into your client repositories." />
					<TextBlock Text="Setup takes three steps:" FontWeight="SemiBold" />
					<TextBlock TextWrapping="Wrap" Text="1. Choose a private sync folder and, optionally, its Git remote." />
					<TextBlock TextWrapping="Wrap" Text="2. Add the projects whose chats you want to sync." />
					<TextBlock TextWrapping="Wrap" Text="3. Run the first sync. After that, chats sync by themselves when the chat tools close." />
					<TextBlock Style="{StaticResource CaptionStyle}"
							   Text="You can skip this guide and reopen it any time from Settings &gt; Help." />
				</StackPanel>

				<StackPanel x:Name="SetupRepositoryPage" Spacing="12" Visibility="Collapsed">
					<TextBlock TextWrapping="Wrap"
							   Text="Archived chats live in a local folder that is a Git repository dedicated to CodeChatSync. Never choose a client project folder." />
					<TextBlock Style="{StaticResource CaptionStyle}"
							   Text="First PC: choose a new empty folder and keep Initialize on. Other PCs: clone your private chat repository first (git clone), then choose that folder." />
					<Grid ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox x:Name="SetupFolderTextBox" Header="Local sync folder"
								 PlaceholderText="For example C:\chats\my-chat-sync" />
						<Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="OnSetupBrowseFolderClick" />
					</Grid>
					<TextBox x:Name="SetupRemoteTextBox" Header="Git origin URL (optional)"
							 PlaceholderText="https://github.com/owner/my-chats" />
					<TextBlock Style="{StaticResource CaptionStyle}"
							   Text="Create an empty private repository on GitHub or Azure DevOps and paste its URL. Sign-in is handled by Git's credential helper; never put a password in the URL. Leave it blank to keep chats on this PC for now." />
					<CheckBox x:Name="SetupInitializeCheckBox" IsChecked="True"
							  Content="Initialize as a Git repository if needed" />
				</StackPanel>

				<StackPanel x:Name="SetupProjectPage" Spacing="12" Visibility="Collapsed">
					<TextBlock TextWrapping="Wrap"
							   Text="Add the Visual Studio projects whose Copilot chats you want to sync. Choose any folder inside the project's Git repository: its Git remote identifies the project on every PC, whatever its local path." />
					<Grid ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox x:Name="SetupProjectTextBox" Header="Visual Studio project folder"
								 PlaceholderText="Folder inside the project's Git repository" />
						<Button Grid.Column="1" Content="Browse…" VerticalAlignment="Bottom" Click="OnSetupBrowseProjectClick" />
					</Grid>
					<Button x:Name="SetupAddProjectButton" Content="Add project" Click="OnSetupAddProjectClick" />
					<TextBlock x:Name="SetupProjectsText" TextWrapping="Wrap" />
					<TextBlock Style="{StaticResource CaptionStyle}"
							   Text="Using Claude Code? Add its projects later from Projects &gt; Add a project &gt; Claude Code: CodeChatSync lists the projects found in your Claude Code folder. One project can sync both Copilot and Claude Code chats. You can also skip this step and add projects later." />
				</StackPanel>

				<StackPanel x:Name="SetupHowPage" Spacing="12" Visibility="Collapsed">
					<TextBlock TextWrapping="Wrap" Text="Good to know before the first sync:" FontWeight="SemiBold" />
					<TextBlock TextWrapping="Wrap"
							   Text="• CodeChatSync never touches chat files while Visual Studio or Claude Code is running. It waits until they close, then syncs automatically. Only the opt-outs under Advanced change this for manual syncs." />
					<TextBlock TextWrapping="Wrap"
							   Text="• Existing local chats are backed up before being overwritten, and nothing is deleted from the private repository." />
					<TextBlock TextWrapping="Wrap"
							   Text="• By default every archived chat is restored on each PC. Under Projects &gt; Chats to restore on this PC you can choose which ones come back here." />
					<TextBlock TextWrapping="Wrap"
							   Text="• CodeChatSync keeps running in the notification area. Open this window from its tray icon." />
				</StackPanel>

				<StackPanel x:Name="SetupDonePage" Spacing="12" Visibility="Collapsed">
					<TextBlock x:Name="SetupDoneText" TextWrapping="Wrap" />
					<CheckBox x:Name="SetupRunSyncCheckBox" Content="Run the first sync now" />
					<CheckBox x:Name="SetupTourCheckBox" IsChecked="True" Content="Show me around the window" />
					<TextBlock Style="{StaticResource CaptionStyle}"
							   Text="The Get started checklist on the Sync page tracks what is left to do." />
				</StackPanel>

				<InfoBar x:Name="SetupInfoBar" IsOpen="False" IsClosable="True" />
			</StackPanel>
		</ContentDialog>
	</Grid>
</Window>
