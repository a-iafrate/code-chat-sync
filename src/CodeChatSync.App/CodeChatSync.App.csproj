<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CodeChatSync.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseRidGraph>true</UseRidGraph>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\assets\icons\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- assets\icons stays the single source for the icons; they are linked into the
       output instead of being duplicated inside the project. -->
  <ItemGroup>
    <Content Include="..\..\assets\icons\app-icon.ico" Link="Assets\app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\icons\tray-icon.ico" Link="Assets\tray-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeChatSync.Core\CodeChatSync.Core.csproj" />
    <ProjectReference Include="..\CodeChatSync.Git\CodeChatSync.Git.csproj" />
    <ProjectReference Include="..\CodeChatSync.Providers.VisualStudio\CodeChatSync.Providers.VisualStudio.csproj" />
    <ProjectReference Include="..\CodeChatSync.Providers.Claude\CodeChatSync.Providers.Claude.csproj" />
  </ItemGroup>

</Project>
